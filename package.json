{
  "name": "loop-workouts",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node tools/preload-today.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css}\"",
    "lint": "eslint src/app && node tools/check-icons.mjs",
    "unused": "knip --production"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.0.8",
    "@vercel/analytics": "^2.0.1",
    "rxjs": "~7.8.0",
    "three": "^0.187.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@types/three": "^0.187.0",
    "@vitest/browser-playwright": "^5.0.3",
    "angular-eslint": "^22.6.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.3",
    "eslint": "^10.14.0",
    "knip": "^6.44.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "fsevents": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
